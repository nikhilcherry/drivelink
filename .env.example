# Server-side only — do NOT prefix with NEXT_PUBLIC_, or it ships in the
# static client bundle. Set the real value in the Vercel project's
# Environment Variables, or in a local .env.local (gitignored via *.local).
GROQ_API_KEY=

# Optional, defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Hiring form (/hiring) → Supabase. These two ARE meant to be public: the site
# is a static export with no API routes, so the browser writes to Supabase
# directly and row-level security is the real boundary. The key below only
# grants INSERT into public.applications and INSERT into the private `resumes`
# bucket — it cannot read either back. See supabase/migrations/0001_hiring.sql.
# Never put the service_role key here; it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
